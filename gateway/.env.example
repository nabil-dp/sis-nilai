PORT=3000

# Kunci penandatangan JWT (juga dipakai service untuk verifikasi ulang token)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Dikirim gateway lewat header X-Gateway-Secret ke service (dipakai di Tahap 4-5)
GATEWAY_SECRET=ganti-dengan-string-acak-lain-minimal-32-karakter

# Alamat service di belakang gateway 
NILAI_URL=http://localhost:3001
TRANSKRIP_URL=http://localhost:3002

JAM_MULAI=7
JAM_SELESAI=21
